---
import CallCard from "../Hero/CallCard.astro";
import SocialLink from "../Hero/Link.astro";
import { asset } from "../../utils/asset";

interface Props {
    projects: {
        data: any;
        rendered: string;
    }[];
}

const { projects } = Astro.props;
const totalProjects = projects.length;
---

<div id="project-gallery" class="project-gallery">

    <div class="gallery-top">

        <div class="gallery-dots retro-font">

        {projects.map((project, index) => (

            <button
            class="gallery-dot"
            data-dot={index}
            aria-label={`Select project ${index + 1}`}
            >
            {String(index + 1).padStart(2,"0")}
            </button>

        ))}

        </div>

       

    </div>

    <div class="gallery-progress">

        <div
            id="gallery-progress-fill"
            class="gallery-progress-fill"
        />

    </div>

    {projects.map((project, index) => (

        <div
            class="gallery-slide"
            data-slide={index}
            style={index === 0 ? "" : "display:none;"}
        >

            <CallCard
                tag={project.data.tag}
                title={project.data.title}
                shortDescription={project.data.shortDescription}
                fullDescription={project.rendered}
                roles={project.data.roles}
                variant={project.data.variant}
                backgroundImage={asset(project.data.backgroundImage)}
            >

                <Fragment slot="links">

                    {project.data.links?.map((link: { href: string; text: string | undefined; }) => (

                        <SocialLink
                            href={link.href}
                            text={link.text}
                            external={true}
                        />

                    ))}

                </Fragment>

            </CallCard>

        </div>

    ))}

</div>

<script is:inline>

const INTERVAL = 10000;

const gallery = document.getElementById("project-gallery");

const slides = [...gallery.querySelectorAll("[data-slide]")];

const dots = [...gallery.querySelectorAll("[data-dot]")];

const progress = document.getElementById(
    "gallery-progress-fill"
);


let current = 0;

let timer = null;

let animationFrame = null;



function currentCard(){

    return slides[current]
        ?.querySelector(".retro-expandable-card");

}



function isExpanded(){

    return currentCard()?.dataset.active === "true";

}



function updateDots(){

    dots.forEach((dot,index)=>{

        dot.classList.toggle(
            "active",
            index === current
        );

    });

}



function show(index){

    if(index < 0)
        index = slides.length - 1;


    if(index >= slides.length)
        index = 0;



    slides.forEach((slide,i)=>{

        slide.style.display =
            i === index
            ? "block"
            : "none";

    });



    current = index;


    updateDots();


    restartProgress();

}





function next(){

    if(isExpanded())
        return;


    show(current + 1);

}





function startTimer(){

    stopTimer();


    timer = setInterval(()=>{

        next();

    }, INTERVAL);

}





function stopTimer(){

    if(timer){

        clearInterval(timer);

        timer = null;

    }

}





function restartProgress(){

    if(!progress)
        return;



    cancelAnimationFrame(animationFrame);



    progress.style.transition = "none";

    progress.style.transform = "scaleX(0)";



    void progress.offsetWidth;



    if(isExpanded())
        return;



    animationFrame =
        requestAnimationFrame(()=>{


            progress.style.transition =
                `transform ${INTERVAL}ms linear`;


            progress.style.transform =
                "scaleX(1)";


        });

}





function resetGalleryTimer(){

    stopTimer();

    restartProgress();

    startTimer();

}





dots.forEach(dot=>{


    dot.addEventListener("click",()=>{


        const index =
            Number(dot.dataset.dot);


        show(index);


        resetGalleryTimer();


    });


});





slides.forEach(slide=>{


    const card =
        slide.querySelector(
            ".retro-expandable-card"
        );


    card.addEventListener("click",()=>{


        // Let CallCard handle data-active first

        requestAnimationFrame(()=>{


            if(isExpanded()){


                // selected

                stopTimer();

                restartProgress();


            }
            else{


                // deselected

                resetGalleryTimer();


            }


        });


    });


});





// START STATE AFTER RELOAD

show(0);

resetGalleryTimer();



</script>

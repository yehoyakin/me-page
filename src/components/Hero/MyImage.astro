---
// src/components/Hero/MyImage.astro
import { Image } from 'astro:assets';

interface Props {
  src: any;
  alt?: string;
  shape?: 'circle' | 'square' | 'squircle';
  size?: 'sm' | 'md' | 'lg' | 'xl';
  theme?: 'primary' | 'secondary' | 'terminal';
}

const {
  src,
  alt = "Portrait",
  shape = "circle",
  size = "md",
  theme = "primary",
} = Astro.props;

// Added box-border and isolate to prevent background bleed around rounded borders
const baseClasses = "relative overflow-hidden border-4 bg-zinc-950 isolate box-border";

const shapeMap = {
  circle: "rounded-full",
  square: "rounded-none",
  squircle: "rounded-[2rem] md:rounded-[3.5rem]"
};

const sizeMap = {
  sm: "w-32 h-32 md:w-40 md:h-40",
  md: "w-56 h-56 md:w-72 md:h-72",
  lg: "w-72 h-72 md:w-96 md:h-96",
  xl: "w-full h-full absolute inset-0"
};

const themeMap = {
  primary: "border-retro-primary/80 shadow-[0_0_50px_rgba(251,191,36,0.2)]",
  secondary: "border-retro-secondary/80 shadow-[0_0_50px_rgba(34,211,238,0.2)]",
  terminal: "border-retro-terminal/80 shadow-[0_0_50px_rgba(74,222,128,0.2)]"
};

const dynamicContainerClasses = [
  baseClasses,
  shapeMap[shape],
  sizeMap[size],
  themeMap[theme]
].filter(Boolean).join(" ");

// Critical: Forces width/height override and resets inline aspect-ratio from Astro asset optimization
const imgClasses = "absolute inset-0 !w-full !h-full !max-w-none !max-h-none block !object-cover select-none pointer-events-none";
---

<div class={dynamicContainerClasses}>
  {typeof src === 'string' ? (
    <img
      src={src}
      alt={alt}
      class={imgClasses}
    />
  ) : (
    <Image
      src={src}
      alt={alt}
      class={imgClasses}
    />
  )}
</div>
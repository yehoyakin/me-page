---
// Purpose: Component - src/components/Blog/BlogContent.astro (Render post body and scene images)
import { asset } from "../../utils/asset";

interface SceneItem {
  image: string;
  align?: "left" | "right" | "center";
  size?: "auto" | "16:9" | "4:3";
  caption?: string;
}

interface Props {
  bodyHtml: string;
  scenes?: SceneItem[];
}

const { bodyHtml, scenes = [] } = Astro.props as Props;

/**
 * Replace [scene[x]] and [scene[x,y,z]] markers with image blocks.
 * SAFE for BOTH raw paths and asset() resolved paths.
 */
const getAspectClass = (size?: SceneItem["size"]) => {
  switch (size) {
    case "16:9":
      return "aspect-video";
    case "4:3":
      return "aspect-[4/3]";
    default:
      return "";
  }
};

const getCaptionAlignmentClass = (align?: string) => {
  switch (align) {
    case "left":
      return "text-left";
    case "right":
      return "text-right";
    default:
      return "text-center";
  }
};

const getSceneSizeClass = (size?: string) => {
  switch (size) {
    case "wide":
      return "max-w-[980px]";
    case "large":
      return "max-w-[1160px]";
    case "full":
      return "max-w-[1400px]";
    default:
      return "max-w-[720px]";
  }
};

const renderScene = (sceneIndex: number, alignOverride?: string, captionOverride?: string, sizeOverride?: string) => {
  const scene = scenes[sceneIndex];
  if (!scene?.image) return "";

  const align = (alignOverride ?? scene.align ?? "center").toLowerCase();
  const aspectClass = getAspectClass(scene.size ?? "auto");
  const captionAlignClass = getCaptionAlignmentClass(align);
  const captionText = captionOverride ?? scene.caption ?? "";
  const sizeClass = getSceneSizeClass(sizeOverride || "default");

  let figureClass =
    `my-8 overflow-hidden rounded-none border border-zinc-800 bg-black w-full ${sizeClass} mx-auto`;

  let imgClass = "block w-full h-auto";

  if (aspectClass) {
    figureClass += ` ${aspectClass}`;
    imgClass = "block h-full w-full object-cover object-center";
  }

  switch (align) {
    case "left":
      figureClass += " float-left max-w-[45%] mr-6 mb-4";
      break;

    case "right":
      figureClass += " float-right max-w-[45%] ml-6 mb-4";
      break;

    default:
      figureClass += " mb-6";
      break;
  }

  const caption = captionText
    ? `
      <figcaption
        class="mt-2 px-1 text-md tracking-wide text-zinc-400 text-center"
        style="font-family: var(--font-body); font-style: italic; font-weight: 300; letter-spacing: 0.02em;"
      >
        ${captionText}
      </figcaption>
    `
    : "";

  return `
    <figure class="${figureClass}">
      <img
        src="${scene.image}"
        alt="Scene ${sceneIndex}"
        class="${imgClass}"
      />
    </figure>
    ${caption}
  `;
};

const decodeSceneCaption = (value?: string) =>
  (value ?? "")
    .replace(/&quot;/g, '"')
    .replace(/&ldquo;/g, '"')
    .replace(/&rdquo;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lsquo;/g, "'")
    .replace(/&rsquo;/g, "'")
    .replace(/&amp;/g, "&")
    .replace(/[“”]/g, '"')
    .replace(/[‘’]/g, "'")
    .trim();

const parseSceneMarker = (match: string) => {
  const result = match.match(
    /^\[scene\[((?:\d+\s*(?:,\s*\d+)*)?)(?:\s*,\s*(wide|large|full))?\](?:\s*(?:,\s*)?(?:"([^"]*)"|'([^']*)'|“([^”]*)”|‘([^’]*)’|&quot;([^&]+)&quot;|&apos;([^&]+)&apos;|&ldquo;([^&]+)&rdquo;|&lsquo;([^&]+)&rsquo;))?\]$/,
  );

  if (!result) return null;

  const [
    ,
    rawIndexes = "",
    sizeToken = "",
    doubleQuotedCaption = "",
    singleQuotedCaption = "",
    curlyDoubleCaption = "",
    curlySingleCaption = "",
    htmlQuotedCaption = "",
    htmlAposCaption = "",
    htmlCurlyDoubleCaption = "",
    htmlCurlySingleCaption = "",
  ] = result;

  const caption = decodeSceneCaption(
    doubleQuotedCaption ||
      singleQuotedCaption ||
      curlyDoubleCaption ||
      curlySingleCaption ||
      htmlQuotedCaption ||
      htmlAposCaption ||
      htmlCurlyDoubleCaption ||
      htmlCurlySingleCaption,
  );

  const indexes = (rawIndexes || "")
    .split(",")
    .map((value) => Number.parseInt(value.trim(), 10))
    .filter((value): value is number => Number.isInteger(value) && value >= 0);

  return { indexes, caption, size: sizeToken || undefined };
};

const sceneHtml =
  Array.isArray(scenes) && scenes.length > 0
    ? bodyHtml.replace(/\[scene\[((?:\d+\s*(?:,\s*\d+)*)?)(?:\s*,\s*(wide|large|full))?\](?:\s*(?:,\s*)?(?:"[^"]*"|'[^']*'|“[^”]*”|‘[^’]*’|&quot;[^&]+&quot;|&apos;[^&]+&apos;|&ldquo;[^&]+&rdquo;|&lsquo;[^&]+&rsquo;))?\]/g, (match: string) => {
        const parsed = parseSceneMarker(match);
        if (!parsed) return match;

        const { indexes, caption, size } = parsed;
        if (indexes.length === 0) return match;

        if (indexes.length === 1) {
          return renderScene(indexes[0], undefined, caption, size) || match;
        }

        const groupSizeClass = size === "wide"
          ? "max-w-[980px] mx-auto"
          : size === "large"
            ? "max-w-[1160px] mx-auto"
            : size === "full"
              ? "max-w-[1400px] mx-auto"
              : "max-w-[1200px] mx-auto";
        const groupClass = `my-8 grid gap-4 sm:grid-cols-2 ${groupSizeClass}`.trim();
        const groupCaptionText = decodeSceneCaption(caption || scenes[indexes[0]]?.caption || "");

        const groupedScenes = indexes
          .map((sceneIndex: number) => {
            const scene = scenes[sceneIndex];
            if (!scene?.image) return "";

            const align = (scene.align ?? "center").toLowerCase();
            const aspectClass = getAspectClass(scene.size ?? "auto");
            const figureClass = `my-0 overflow-hidden rounded-none border border-zinc-800 bg-black w-full ${aspectClass ? aspectClass : ""}`.trim();
            const imgClass = aspectClass
              ? "block h-full w-full object-cover object-center"
              : "block w-full h-auto";

            return `
              <figure class="${figureClass}">
                <img
                  src="${scene.image}"
                  alt="Scene ${sceneIndex}"
                  class="${imgClass}"
                />
              </figure>
            `;
          })
          .filter(Boolean)
          .join("\n");

        const groupCaptionMarkup = groupCaptionText
          ? `
            <figcaption
              class="mt-2 px-1 text-md tracking-wide text-zinc-400 text-center"
              style="font-family: var(--font-body); font-style: italic; font-weight: 300; letter-spacing: 0.02em;"
            >
              ${groupCaptionText}
            </figcaption>
          `
          : "";

        return `<div class="${groupClass}">${groupedScenes}</div>${groupCaptionMarkup}`;
      })
    : bodyHtml;
---

{/* Article content container. */}
<div
  class="prose prose-invert max-w-none rounded-none
         border border-zinc-800/50 bg-zinc-950/70
         p-5 sm:p-8 backdrop-blur-md"
  id="blog-content"
  style={`--project-tag-color: var(--retro-primary); --callcard-accent: var(--project-tag-color); --callcard-italic-accent: color-mix(in srgb, var(--project-tag-color) 25%, white);`}
>
  <div set:html={sceneHtml} />
</div>

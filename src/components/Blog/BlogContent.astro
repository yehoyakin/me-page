---
// Purpose: Component - src/components/Blog/BlogContent.astro (Render post body and scene images)
import { asset } from "../../utils/asset";

interface SceneItem {
  image: string;
  align?: "left" | "right" | "center";
  size?: "auto" | "16:9" | "4:3";
  caption?: string;
}

interface Props {
  bodyHtml: string;
  scenes?: SceneItem[];
}

const { bodyHtml, scenes = [] } = Astro.props as Props;

/**
 * Replace [scene[x]] and [scene[x,y,z]] markers with image blocks.
 * SAFE for BOTH raw paths and asset() resolved paths.
 */
const getAspectClass = (size?: SceneItem["size"]) => {
  switch (size) {
    case "16:9":
      return "aspect-video";
    case "4:3":
      return "aspect-[4/3]";
    default:
      return "";
  }
};

const getCaptionAlignmentClass = (align?: string) => {
  switch (align) {
    case "left":
      return "text-left";
    case "right":
      return "text-right";
    default:
      return "text-center";
  }
};

const getSceneSizeClass = (size?: string) => {
  switch (size) {
    case "wide":
      return "max-w-[80vw]";
    case "large":
      return "max-w-[90vw]";
    case "full":
      return "max-w-[95vw]";
    default:
      return "max-w-[60vw]";
  }
};

/**
 * Clean up a caption string: strip quotes (straight or curly), HTML entities, trim.
 */
const cleanCaption = (raw: string): string => {
  return raw
    .replace(/^[\s,]*/, "")
    .replace(/&quot;/g, '"')
    .replace(/&ldquo;/g, '"')
    .replace(/&rdquo;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lsquo;/g, "'")
    .replace(/&rsquo;/g, "'")
    .replace(/&amp;/g, "&")
    .replace(/^["""\u201c\u201d]/, "")
    .replace(/["""\u201c\u201d]$/, "")
    .replace(/^['''\u2018\u2019]/, "")
    .replace(/['''\u2018\u2019]$/, "")
    .trim();
};

const renderScene = (sceneIndex: number, alignOverride?: string, captionOverride?: string, sizeOverride?: string) => {
  const scene = scenes[sceneIndex];
  if (!scene?.image) return "";

  const align = (alignOverride ?? scene.align ?? "center").toLowerCase();
  const aspectClass = getAspectClass(scene.size ?? "auto");
  const captionText = captionOverride ?? scene.caption ?? "";
  const sizeClass = getSceneSizeClass(sizeOverride || "default");

  let figureClass =
    `scene-reveal my-8 overflow-hidden rounded-none border border-zinc-800 bg-black w-full ${sizeClass} mx-auto`;

  let imgClass = "block w-full h-auto";

  if (aspectClass) {
    figureClass += ` ${aspectClass}`;
    imgClass = "block h-full w-full object-cover object-center";
  }

  switch (align) {
    case "left":
      figureClass += " float-left max-w-[45%] mr-6 mb-4";
      break;

    case "right":
      figureClass += " float-right max-w-[45%] ml-6 mb-4";
      break;

    default:
      figureClass += " mb-6";
      break;
  }

  const caption = captionText
    ? `
      <figcaption
        class="mt-2 px-1 text-md tracking-wide text-zinc-400 text-center"
        style="font-family: var(--font-body); font-style: italic; font-weight: 300; letter-spacing: 0.02em;"
      >
        ${captionText}
      </figcaption>
    `
    : "";

  return `
    <figure class="${figureClass}">
      <img
        src="${scene.image}"
        alt="Scene ${sceneIndex}"
        class="${imgClass}"
      />
    </figure>
    ${caption}
  `;
};

/**
 * Match scene markers in rendered HTML.
 * Handles: [scene[0]], [scene[0,1,2]], [scene[0, wide]], [scene[0], "caption"]
 * Works regardless of quote type (straight, curly, HTML entities).
 *
 * Pattern: [scene[indexes, optional_size], optional_caption_text]
 * We capture everything after the inner ] as the raw caption text.
 */
const SCENE_MARKER_RE = /\[scene\[([0-9,\s]+)(?:,\s*(wide|large|full))?\](?:,\s*([^\]]*))?\]/g;

const parseSceneMarker = (match: string) => {
  const result = SCENE_MARKER_RE.exec(match);
  if (!result) return null;

  const [, rawIndexes = "", sizeToken = "", rawCaption = ""] = result;

  const indexes = rawIndexes
    .split(",")
    .map((v) => Number.parseInt(v.trim(), 10))
    .filter((v): v is number => Number.isInteger(v) && v >= 0);

  const caption = cleanCaption(rawCaption);

  return { indexes, caption, size: sizeToken || undefined };
};

const sceneHtml =
  Array.isArray(scenes) && scenes.length > 0
    ? bodyHtml.replace(SCENE_MARKER_RE, (match: string) => {
        // Reset lastIndex since we're using a global regex
        SCENE_MARKER_RE.lastIndex = 0;
        const parsed = parseSceneMarker(match);
        if (!parsed) return match;

        const { indexes, caption, size } = parsed;
        if (indexes.length === 0) return match;

        if (indexes.length === 1) {
          return renderScene(indexes[0], undefined, caption, size) || match;
        }

        const groupSizeClass = size === "wide"
          ? "max-w-[80vw] mx-auto"
          : size === "large"
            ? "max-w-[90vw] mx-auto"
            : size === "full"
              ? "max-w-[95vw] mx-auto"
              : "max-w-[85vw] mx-auto";
        const groupClass = `scene-reveal my-8 grid gap-4 sm:grid-cols-2 ${groupSizeClass}`.trim();
        const groupCaptionText = cleanCaption(caption || scenes[indexes[0]]?.caption || "");

        const groupedScenes = indexes
          .map((sceneIndex: number) => {
            const scene = scenes[sceneIndex];
            if (!scene?.image) return "";

            const aspectClass = getAspectClass(scene.size ?? "auto");
            const figureClass = `my-0 overflow-hidden rounded-none border border-zinc-800 bg-black w-full ${aspectClass ? aspectClass : ""}`.trim();
            const imgClass = aspectClass
              ? "block h-full w-full object-cover object-center"
              : "block w-full h-auto";

            return `
              <figure class="${figureClass}">
                <img
                  src="${scene.image}"
                  alt="Scene ${sceneIndex}"
                  class="${imgClass}"
                />
              </figure>
            `;
          })
          .filter(Boolean)
          .join("\n");

        const groupCaptionMarkup = groupCaptionText
          ? `
            <figcaption
              class="mt-2 px-1 text-md tracking-wide text-zinc-400 text-center"
              style="font-family: var(--font-body); font-style: italic; font-weight: 300; letter-spacing: 0.02em;"
            >
              ${groupCaptionText}
            </figcaption>
          `
          : "";

        return `<div class="${groupClass}">${groupedScenes}</div>${groupCaptionMarkup}`;
      })
    : bodyHtml;
---

{/* Article content container. */}
<div
  class="prose prose-invert max-w-none rounded-none
         border border-zinc-800/50 bg-black/60
         p-6 sm:p-10 md:p-12 backdrop-blur-2xl
         shadow-[inset_0_0_80px_rgba(0,0,0,0.4)]"
  id="blog-content"
>
  <div set:html={sceneHtml} />
</div>

<style is:global>
  /* Scroll-reveal: figures start hidden, fade in on scroll */
  .scene-reveal {
    opacity: 0;
    transform: translateY(2rem);
    transition: opacity 0.7s cubic-bezier(0.2, 0.8, 0.2, 1),
                transform 0.7s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .scene-reveal.revealed {
    opacity: 1;
    transform: translateY(0);
  }

  /* Stagger children in grouped scene grids */
  .scene-reveal.revealed > *:nth-child(1) { transition-delay: 0ms; }
  .scene-reveal.revealed > *:nth-child(2) { transition-delay: 100ms; }
  .scene-reveal.revealed > *:nth-child(3) { transition-delay: 200ms; }
  .scene-reveal.revealed > *:nth-child(4) { transition-delay: 300ms; }

  @media (prefers-reduced-motion: reduce) {
    .scene-reveal {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>

<script is:inline>
  (function () {
    const initReveal = () => {
      const figures = document.querySelectorAll(".scene-reveal");
      if (!figures.length) return;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("revealed");
              observer.unobserve(entry.target);
            }
          });
        },
        { threshold: 0.15, rootMargin: "0px 0px -50px 0px" }
      );

      figures.forEach((fig) => observer.observe(fig));
    };

    document.addEventListener("astro:page-load", initReveal);
    document.addEventListener("DOMContentLoaded", initReveal);
    initReveal();
  })();
</script>

---
// Purpose: Component - src/components/shared/MyImage.astro (Responsive image wrapper)
import { Image } from "astro:assets";

interface Props {
  src: any;
  alt?: string;
  shape?: "circle" | "square" | "squircle";
  size?: "sm" | "md" | "lg" | "xl";
  theme?: string;
}

const {
  src,
  alt = "Portrait",
  shape = "circle",
  size = "md",
  theme = "primary",
} = Astro.props;

const baseClasses =
  "relative overflow-hidden bg-zinc-950 isolate box-border";

const shapeMap = {
  circle: "rounded-full",
  square: "rounded-none",
  squircle: "rounded-[2rem] md:rounded-[3.5rem]",
};

const sizeMap = {
  sm: "w-32 h-32 md:w-40 md:h-40",
  md: "w-56 h-56 md:w-72 md:h-72",
  lg: "w-72 h-72 md:w-96 md:h-96",
  xl: "w-full h-full absolute inset-0",
};

const dynamicContainerClasses = [
  baseClasses,
  shapeMap[shape],
  sizeMap[size],
]
  .filter(Boolean)
  .join(" ");

// Critical: Forces width/height override and resets inline aspect-ratio from Astro asset optimization
const imgClasses =
  "absolute inset-0 !w-full !h-full !max-w-none !max-h-none block !object-cover select-none pointer-events-none";
---

<div class={dynamicContainerClasses}>
  {
    typeof src === "string" ? (
      <img src={src} alt={alt} class={imgClasses} />
    ) : (
      <Image src={src} alt={alt} class={imgClasses} />
    )
  }
</div>

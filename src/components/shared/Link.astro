---
// Purpose: Component - src/components/shared/Link.astro (Generic link button component)
interface Props {
  href: string;
  text?: string;
  icon?: string;
  external?: boolean;
}

const { href, text = "", icon, external } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  class="retro-link
    group
    relative
    overflow-hidden
    flex
    items-center
    justify-center
    gap-2
    rounded-none
    px-4
    py-2
    text-xs
    uppercase
    tracking-[0.25em]
    text-white
    bg-zinc-950
    border-2
    border-white/70
    transition-all
    duration-100
    ease-[steps(2)]
    hover:bg-white
    hover:text-zinc-950
    hover:border-white
    hover:translate-x-[-2px]
    hover:translate-y-[-2px]
    hover:shadow-[4px_4px_0px_0px_white]"
>
  {
    false && icon && (
      <span class="flex items-center justify-center">
        <img src={icon} class="w-4 h-4 object-cover" alt="" />
      </span>
    )
  }

  <span class="relative z-10">
    {text}
  </span>

  <span class="pixel-highlight"></span>
</a>

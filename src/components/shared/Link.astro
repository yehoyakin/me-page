---
// Purpose: Component - src/components/shared/Link.astro (Generic link button component)
interface Props {
  href: string;
  text?: string;
  icon?: string;
  external?: boolean;
}

const { href, text = "", icon, external } = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  class="retro-link
    group
    relative
    overflow-hidden
    flex
    items-center
    justify-center
    gap-2
    rounded-none
    px-4
    py-2
    text-xs
    uppercase
    tracking-[0.25em]
    text-white
    bg-zinc-950
    border-2
    border-white/70
    transition-all
    duration-100
    ease-[steps(2)]
    hover:bg-white
    hover:text-zinc-950
    hover:border-white
    hover:translate-x-[-2px]
    hover:translate-y-[-2px]
    hover:shadow-[0.25rem_0.25rem_0px_0px_white]"
>
  {/* Light sweep — scrolls across button every 4s when idle */}
  <span
    class="link-sweep absolute inset-0 pointer-events-none
           transition-opacity duration-300 ease-out
           group-hover:opacity-0"
    aria-hidden="true"
  />

  {
    false && icon && (
      <span class="flex items-center justify-center">
        <img src={icon} class="w-4 h-4 object-cover" alt="" />
      </span>
    )
  }

  <span class="relative z-10">
    {text}
  </span>

  <span class="pixel-highlight"></span>
</a>

<style>
  .link-sweep {
    background: linear-gradient(
      105deg,
      transparent 0%,
      transparent 30%,
      rgba(255, 255, 255, 0.25) 42%,
      rgba(255, 255, 255, 0.5) 50%,
      rgba(255, 255, 255, 0.25) 58%,
      transparent 70%,
      transparent 100%
    );
    background-size: 250% 100%;
    animation: linkSweep 4s cubic-bezier(0.4, 0, 0.2, 1) infinite;
  }

  @keyframes linkSweep {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -50% 0;
    }
  }
</style>

---
// Purpose: Component - src/components/UI/Body.astro (UI Body / paragraph styling)
import { getThemeConfig, resolveThemeToken, toThemeName } from "../../config/uiDictionary";

interface Props {
  class?: string;
  /** Theme name — controls color and transition. Any string works. */
  theme?: string;
  /** Add subtle text shadow for readability against blurred backgrounds. */
  shadow?: boolean;
}

const { class: customClass = "", theme: rawTheme, shadow = false } = Astro.props;
const themeName = toThemeName(rawTheme);
const config = getThemeConfig(themeName);
const themeToken = resolveThemeToken(themeName);
---

<p
  class:list={[
    config.text.base,
    config.text.hover,
    "transition-colors",
    "text-sm sm:text-base leading-relaxed break-words max-w-prose",
    "theme-color",
    shadow && "readable-text",
    customClass,
  ]}
  style={`--project-tag-color: ${themeToken}`}
>
  <slot />
</p>

---
// Purpose: Component - src/components/UI/Title.astro (UI Title component)
import { getThemeConfig, resolveThemeToken, toThemeName } from "../../config/uiDictionary";

interface Props {
  class?: string;
  level?: 1 | 2 | 3 | 4 | 5 | 6;
  outline?: boolean;
  /** Theme name — controls color and transition. Any string works. */
  theme?: string;
}

const {
  class: customClass = "",
  level = 2,
  outline = true,
  theme: rawTheme,
} = Astro.props;

const themeName = toThemeName(rawTheme);
const config = getThemeConfig(themeName);
const themeToken = resolveThemeToken(themeName);

const Tag = `h${level}` as any;

// Fluid handling rules using container queries (cqw) so text adapts to card size, not screen size
const fluidSizing = {
  1: "text-[clamp(1.5rem,12cqw,3rem)] leading-none",
  2: "text-[clamp(1.1rem,10cqw,2rem)] leading-tight",
  3: "text-xl leading-tight",
  4: "text-lg",
  5: "text-base",
  6: "text-sm",
};

const defaultFluidClass =
  fluidSizing[level as keyof typeof fluidSizing] || "text-lg";

// PowerPoint-style shadowed outline: solid black shadow offset down-right.
// Works at all sizes without geometry collapse.
const shadowStyle = outline
  ? `text-shadow: 2px 2px 0 #000, -1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000; --project-tag-color: ${themeToken}`
  : `--project-tag-color: ${themeToken}`;
---

<Tag
  class:list={[
    config.text.base,
    config.text.hover,
    "transition-colors font-bold break-normal whitespace-normal tracking-wide",
    defaultFluidClass,
    "theme-color",
    customClass,
  ]}
  style={shadowStyle}
>
  <slot />
</Tag>

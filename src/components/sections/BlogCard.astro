---
import type { BlogPost } from "../../types/blog";
import Title from "../UI/Title.astro";
// Purpose: Section - src/components/sections/BlogCard.astro (Compact blog summary card)
import Body from "../UI/Body.astro";
import { resolveThemeToken, toThemeName } from "../../config/uiDictionary";
import { asset } from "../../utils/asset";

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;

const date = new Date(post.data.date);

const themeName = toThemeName(post.data.theme);
const dynamicToken = resolveThemeToken(themeName);

// whether it evaluates to "/" in dev or "/me-page/" in production.
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<a
  href={`${baseUrl}blog/${post.id}/`}
  class="group blog-card relative block overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/40 p-4 sm:p-6 md:p-8"
  style={`--project-tag-color: ${dynamicToken}`}
>
  {/* BACKGROUND IMAGE */}
  {
    post.data.cardBackground && (
      <div class="absolute inset-0 overflow-hidden">
        <div
          class="blog-card-bg absolute inset-0 scale-100 group-hover:scale-105"
          style={`
          background-image: url('${asset(post.data.cardBackground)}');
          background-size: cover;
          background-position: center center;
        `}
        />

        {/* OVERLAY */}
        <div
          class="blog-card-overlay absolute inset-0
               bg-gradient-to-r from-zinc-950/85 via-zinc-900/50 to-zinc-950/30
               group-hover:from-zinc-950/70
               group-hover:via-zinc-900/30
               group-hover:to-zinc-950/15"
        />
      </div>
    )
  }

  {/* CONTENT */}
  <div class="relative z-10 flex items-start justify-between gap-4">
    <div class="space-y-4 flex-1">
      <Body
        theme={themeName}
        class="blog-card-date text-xs sm:text-sm text-zinc-500 group-hover:text-[color:var(--project-tag-color)] readable-text"
      >
        {date.toDateString()}
      </Body>

      <Title
        level={2}
        theme={themeName}
        class="blog-card-title mt-2 text-2xl sm:text-3xl group-hover:text-[color:var(--project-tag-color)] readable-text"
      >
        {post.data.title}
      </Title>

      <Body
        theme={themeName}
        class="blog-card-desc mt-3 sm:mt-4 text-sm sm:text-base text-zinc-800 group-hover:text-zinc-300 readable-text"
      >
        {post.data.description}
      </Body>
    </div>
  </div>
</a>

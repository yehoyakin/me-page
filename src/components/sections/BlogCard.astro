---
import type { BlogPost } from "../../types/blog";
import Title from "../UI/Title.astro";
// Purpose: Section - src/components/sections/BlogCard.astro (Compact blog summary card)
import Body from "../UI/Body.astro";
import { uiDictionary, resolveThemeToken, toUiVariant } from "../../config/uiDictionary";
import { asset } from "../../utils/asset";

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;

const date = new Date(post.data.date);

const postVariant = toUiVariant(post.data.theme ?? post.data.theme);

const postConfig = uiDictionary[postVariant];

const dynamicToken = resolveThemeToken(postConfig.theme);

// whether it evaluates to "/" in dev or "/me-page/" in production.
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
---

<a
  href={`${baseUrl}blog/${post.id}/`}
  class="group relative block overflow-hidden rounded-xl border border-zinc-800 bg-zinc-950/40 p-4 sm:p-6 md:p-8
         transition duration-700 ease-out
         hover:border-retro-primary/70
         hover:shadow-[0_0_80px_rgba(251,191,36,0.15)]"
  style={`--project-tag-color: ${dynamicToken}`}
>
  {/* BACKGROUND IMAGE */}
  {
    post.data.cardBackground && (
      <div class="absolute inset-0 overflow-hidden">
        <div
          class="absolute inset-0 scale-100 transition duration-[1600ms] ease-[cubic-bezier(0.22,1,0.36,1)]
               group-hover:scale-125 group-hover:brightness-110"
          style={`
          /* Resolve the background image through the shared asset helper. */
          background-image: url('${asset(post.data.cardBackground)}');
          background-size: cover;
          background-position: center center;
        `}
        />

        {/* VIGNETTE */}
        <div
          class="absolute inset-0 transition duration-700
               bg-gradient-to-r from-zinc-950/90 via-zinc-900/50 to-zinc-950/30
               group-hover:from-zinc-950/70
               group-hover:via-zinc-900/20
               group-hover:to-zinc-950/10"
        />

        {/* GLOW */}
        <div
          class="absolute inset-0 opacity-0 transition duration-700
               group-hover:opacity-100
               bg-[radial-gradient(circle_at_center,rgba(251,191,36,0.12),transparent_70%)]"
        />

        {/* LIGHT SWEEP */}
        <div class="absolute inset-0 opacity-0 transition duration-700 pointer-events-none group-hover:opacity-100">
          <div
            class="absolute -left-1/2 top-0 h-full w-1/2 rotate-12
                 bg-gradient-to-r from-transparent via-white/10 to-transparent
                 blur-xl animate-[sweep_1.2s_ease-out]"
          />
        </div>
      </div>
    )
  }

  {/* CONTENT */}
  <div class="relative z-10 flex items-start justify-between gap-4">
    <div class="space-y-4 flex-1">
      <Body
        class="text-xs sm:text-sm text-zinc-500 transition duration-500 group-hover:text-[color:var(--project-tag-color)]"
      >
        {date.toDateString()}
      </Body>

      <Title
        level={2}
        class="mt-2 text-2xl sm:text-3xl transition duration-500 group-hover:text-[color:var(--project-tag-color)]"
      >
        {post.data.title}
      </Title>

      <Body
        class="mt-3 sm:mt-4 text-sm sm:text-base text-zinc-400 transition duration-500 group-hover:text-zinc-300"
      >
        {post.data.description}
      </Body>
    </div>
  </div>
</a>

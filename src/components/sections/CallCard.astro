---
import Title from "../ui/Title.astro";
import Body from "../ui/Body.astro";
import { uiDictionary } from "../../config/uiDictionary";
import type { ProjectRole, UiVariant } from "../../config/uiDictionary";

interface Props {
  tag: string;
  title: string;
  shortDescription: string;
  fullDescription?: string;
  roles?: ProjectRole[];
  variant?: UiVariant;
  class?: string;
  backgroundImage?: string;
}

const roleLabels: Record<ProjectRole, string> = {
  lead_programmer: "Lead Programmer",
  ui: "UI",
  game_design: "Game Design",
  art: "Art",
  audio: "Audio",
  tech_art: "Tech Art",
  systems: "Systems",
  tools: "Tools",
  developer: "Developer"
};

const {
  tag,
  title,
  shortDescription,
  fullDescription = "",
  roles = [],
  variant = "primary",
  class: extraClass = "",
  backgroundImage
} = Astro.props;


const config = uiDictionary[variant];


const dynamicToken =
  config.theme === "primary"
    ? "var(--retro-primary)"
    : config.theme === "secondary"
      ? "var(--retro-secondary)"
      : "var(--retro-terminal)";


const themeColorClass =
  config.theme === "primary"
    ? "text-[color:var(--retro-primary)]"
    : config.theme === "secondary"
      ? "text-[color:var(--retro-secondary)]"
      : "text-[color:var(--retro-terminal)]";


const EXPANDED_CARD_BORDER_THICKNESS = "8px";
const CARD_EXPANSION_DURATION_MS = 200;
const DRAWER_REVEAL_DURATION_MS = 200;
const DRAWER_REVEAL_VERTICAL_OFFSET = "20px";
const PIXELATED_TRANSITION_STEPS = 200;


const baseText =
  "transition-colors duration-150 ease-[steps(200)] retro-outline drop-shadow-[0_2px_4px_rgba(0,0,0,1)]";


const cardClasses = [
  "group retro-expandable-card relative rounded-none border bg-zinc-950",
  "w-full overflow-hidden select-none",
  extraClass
].join(" ");
---

<div
  class={cardClasses}
  data-theme={config.transition}
  data-active="false"
  style={`
    --current-token: ${dynamicToken};
    --expanded-card-border-width: ${EXPANDED_CARD_BORDER_THICKNESS};
    --drawer-offset: ${DRAWER_REVEAL_VERTICAL_OFFSET};
    --card-transition-duration: ${CARD_EXPANSION_DURATION_MS}ms;
    --drawer-transition-duration: ${DRAWER_REVEAL_DURATION_MS}ms;
    --pixel-transition-steps: ${PIXELATED_TRANSITION_STEPS};
  `}
  onclick="
    const state = this.getAttribute('data-active') === 'true';

    document
      .querySelectorAll('.retro-expandable-card')
      .forEach(card =>
        card.setAttribute('data-active','false')
      );

    this.setAttribute(
      'data-active',
      state ? 'false' : 'true'
    );
  "
>

  <div class="card-main-layout">

    <!-- LEFT INFORMATION AREA -->

    <div class="card-info-panel">

      <div class="card-title-area">

        {tag && (
          <span
            class={`card-tag ${baseText} ${themeColorClass}`}
          >
            {tag}
          </span>
        )}


        <Title
          class={`card-project-title text-white ${baseText}`}
        >
          {title}
        </Title>


        <Body
          class={`card-description ${baseText}`}
        >
          {shortDescription}
        </Body>

      </div>


      <div class="card-footer">

        <div class="card-links">
          <slot name="links" />
        </div>


        <div
          class={`project-description-hint ${baseText} ${themeColorClass}`}
        >
          CLICK FOR MORE
        </div>

      </div>

    </div>



    <!-- RIGHT IMAGE AREA -->

    {backgroundImage && (

      <div class="card-preview-frame">

        <img
          src={backgroundImage}
          class="card-preview-image"
          alt=""
        />

      </div>

    )}

  </div>


    <!-- EXPANDED CONTENT -->

  <div class="card-expanded-content">

    {fullDescription && (

      <div class="project-preview">

        <div class="project-description-preview">

          <div
            class="prose prose-invert max-w-none text-sm sm:text-base text-zinc-300 drop-shadow-[0_1px_3px_rgba(0,0,0,1)]"
            set:html={fullDescription}
          />

        </div>

      </div>

    )}



    {fullDescription && (

      <div class="project-drawer">

        <div
          class="project-drawer-inner"
        >

          <div
            class="prose prose-invert max-w-none text-sm sm:text-base text-zinc-200"
            set:html={fullDescription}
          />



          {roles.length > 0 && (

            <div class="project-role-list">

              {roles.map((role) => (

                <span class="project-role">

                  {roleLabels[role]}

                </span>

              ))}

            </div>

          )}

        </div>

      </div>

    )}

  </div>

</div>
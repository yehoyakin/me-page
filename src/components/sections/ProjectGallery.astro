---
import CallCard from "./CallCard.astro";
import SocialLink from "../shared/Link.astro";
// Purpose: Section - src/components/sections/ProjectGallery.astro (Grid of project call cards)
import { asset } from "../../utils/asset";

interface Props {
  projects: {
    data: any;
    rendered: string;
  }[];
}

const { projects } = Astro.props;
const totalProjects = projects.length;
---

<div id="project-gallery" class="project-gallery">
  <div class="gallery-top">
    <div class="gallery-dots retro-font">
        {
          projects.map((project, index) => (
            <button
              class="gallery-thumb"
              data-dot={index}
              aria-label={`Select project ${project.data.title ?? index + 1}`}
              title={project.data.title}
            >
              {project.data.backgroundImage ? (
                  <img src={asset(project.data.backgroundImage)} alt={project.data.title ?? `Project ${index + 1}`} loading="lazy" decoding="async" />
                ) : (
                <span class="thumb-fallback">{project.data.title ?? String(index + 1).padStart(2, "0")}</span>
              )}
            </button>
          ))
        }
    </div>
  </div>

  <div class="gallery-progress">
    <div id="gallery-progress-fill" class="gallery-progress-fill"></div>
  </div>

  {
    projects.map((project, index) => (
      <div
        class="gallery-slide"
        data-slide={index}
        style={index === 0 ? "" : "display:none;"}
      >
        <CallCard
          tag={project.data.tag}
          title={project.data.title}
          shortDescription={project.data.shortDescription}
          fullDescription={project.rendered}
          roles={project.data.roles}
          variant={project.data.variant}
          backgroundImage={asset(project.data.backgroundImage)}
        >
          <Fragment slot="links">
            {project.data.links?.map(
              (link: { href: string; text: string | undefined }) => (
                <SocialLink href={link.href} text={link.text} external={true} />
              ),
            )}
          </Fragment>
        </CallCard>
      </div>
    ))
  }
</div>

<script is:inline>
  const INTERVAL = 20000;

  function initGallery() {
    const gallery = document.getElementById("project-gallery");
    if (!gallery) return;

    // Prevent double init — but first clear any leftover timers from previous page
    if (gallery.dataset.galleryInitialized === "true") return;
    gallery.dataset.galleryInitialized = "true";

    // Clear stale timers/RAF stored on the element from a previous page's init
    if (gallery._timer) clearInterval(gallery._timer);
    if (gallery._raf) cancelAnimationFrame(gallery._raf);
    gallery._timer = null;
    gallery._raf = null;

    const slides = [...gallery.querySelectorAll("[data-slide]")];
    const dots = [...gallery.querySelectorAll("[data-dot]")];
    const progress = document.getElementById("gallery-progress-fill");

    let current = 0;

    // Store timers on the gallery element so they survive across navigations
    gallery._timer = null;
    gallery._raf = null;

    function currentCard() {
      return slides[current]?.querySelector(".retro-expandable-card");
    }

    function isExpanded() {
      return currentCard()?.dataset.active === "true";
    }

    function updateDots() {
      dots.forEach((dot, index) => {
        dot.classList.toggle("active", index === current);
      });
    }

    function show(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      // Deselect any expanded card when advancing to another project
      document.querySelectorAll(".retro-expandable-card").forEach((card) => {
        card.setAttribute("data-active", "false");
      });

      slides.forEach((slide, i) => {
        slide.style.display = i === index ? "block" : "none";
      });

      current = index;
      updateDots();
      restartProgress();
    }

    function next() {
      if (isExpanded()) return;
      show(current + 1);
    }

    function startTimer() {
      stopTimer();
      gallery._timer = setInterval(() => {
        next();
      }, INTERVAL);
    }

    function stopTimer() {
      if (gallery._timer) {
        clearInterval(gallery._timer);
        gallery._timer = null;
      }
    }

    function restartProgress() {
      if (!progress) return;
      if (gallery._raf) cancelAnimationFrame(gallery._raf);
      progress.style.transition = "none";
      progress.style.transform = "scaleX(0)";
      void progress.offsetWidth;
      if (isExpanded()) return;
      gallery._raf = requestAnimationFrame(() => {
        progress.style.transition = `transform ${INTERVAL}ms linear`;
        progress.style.transform = "scaleX(1)";
      });
    }

    function resetGalleryTimer() {
      stopTimer();
      restartProgress();
      startTimer();
    }

    function handleCardClick() {
      // Let CallCard handle data-active first, then sync gallery
      requestAnimationFrame(() => {
        if (isExpanded()) {
          stopTimer();
          restartProgress();
        } else {
          resetGalleryTimer();
        }
      });
    }

    // Dot click handlers
    dots.forEach((dot) => {
      dot.addEventListener("click", () => {
        const index = Number(dot.dataset.dot);
        show(index);
        resetGalleryTimer();
      });
    });

    // Card click handlers
    slides.forEach((slide) => {
      const card = slide.querySelector(".retro-expandable-card");
      if (card) {
        card.addEventListener("click", handleCardClick);
      }
    });

    // Listen for custom card-toggle events from CallCard
    gallery.addEventListener("card-toggle", () => {
      requestAnimationFrame(() => {
        if (isExpanded()) {
          stopTimer();
          restartProgress();
        } else {
          resetGalleryTimer();
        }
      });
    });

    // START STATE
    show(0);
    resetGalleryTimer();
  }

  function destroyGallery() {
    const gallery = document.getElementById("project-gallery");
    if (!gallery) return;
    gallery.dataset.galleryInitialized = "false";
    // Clear timers stored on the element
    if (gallery._timer) {
      clearInterval(gallery._timer);
      gallery._timer = null;
    }
    if (gallery._raf) {
      cancelAnimationFrame(gallery._raf);
      gallery._raf = null;
    }
  }

  // Initial load
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }

  // Re-init after Astro client-side navigation
  document.addEventListener("astro:after-swap", () => {
    destroyGallery();
    initGallery();
  });
</script>

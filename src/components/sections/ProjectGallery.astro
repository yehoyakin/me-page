---
import CallCard from "./CallCard.astro";
import SocialLink from "../shared/Link.astro";
import { asset } from "../../utils/asset";

interface Props {
  projects: {
    data: any;
    rendered: string;
  }[];
}

const { projects } = Astro.props;
const totalProjects = projects.length;
---

<div id="project-gallery" class="project-gallery">
  <div id="gallery-bg" class="gallery-bg" aria-hidden="true">
    <img id="gallery-bg-img" class="gallery-bg-img" src={projects[0] ? asset(projects[0].data.images[0]) : ""} alt="" />
    <div class="gallery-bg-overlay"></div>
  </div>

  <!-- Horizontal scrollable thumbnail strip -->
  <div class="gallery-thumbnails-wrapper">
    <div class="gallery-thumbnails">
      {
        projects.map((project, index) => (
          <div class="gallery-thumb-card" data-index={index}>
            <button
              class="gallery-thumb"
              data-dot={index}
              aria-label={`Select project ${project.data.title ?? index + 1}`}
              title={project.data.title}
            >
              <!-- Image carousel container -->
              <div class="thumb-carousel" data-images={JSON.stringify(project.data.images.map(asset))}>
                {project.data.images.map((img: string, imgIndex: number) => (
                  <img
                    src={asset(img)}
                    alt={`${project.data.title ?? `Project ${index + 1}`} - Image ${imgIndex + 1}`}
                    class={`thumb-carousel-img ${imgIndex === 0 ? 'active' : ''}`}
                    loading="lazy"
                    decoding="async"
                  />
                ))}
              </div>
              <!-- Tag overlay -->
              <div class="thumb-tag-overlay">
                <span class="thumb-tag retro-font">{project.data.tag}</span>
              </div>
            </button>
            <!-- Links below thumbnail -->
            <div class="thumb-links">
              {project.data.links?.map(
                (link: { href: string; text: string | undefined }) => (
                  <SocialLink href={link.href} text={link.text} external={true} />
                ),
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="gallery-progress">
    <div id="gallery-progress-fill" class="gallery-progress-fill"></div>
  </div>

  {
    projects.map((project, index) => (
      <div
        class="gallery-slide"
        data-slide={index}
        data-bg={asset(project.data.images[0])}
        style={index === 0 ? "" : "display:none;"}
      >
        <CallCard
          tag={project.data.tag}
          title={project.data.title}
          shortDescription={project.data.shortDescription}
          fullDescription={project.rendered}
          roles={project.data.roles}
          theme={project.data.theme}
          backgroundImage={asset(project.data.images[0])}
        >
          <Fragment slot="links">
            {project.data.links?.map(
              (link: { href: string; text: string | undefined }) => (
                <SocialLink href={link.href} text={link.text} external={true} />
              ),
            )}
          </Fragment>
        </CallCard>
      </div>
    ))
  }
</div>

<script is:inline>
  const INTERVAL = 20000;
  const CAROUSEL_INTERVAL = 3000;

  function initGallery() {
    const gallery = document.getElementById("project-gallery");
    if (!gallery) return;

    if (gallery.dataset.galleryInitialized === "true") return;
    gallery.dataset.galleryInitialized = "true";

    if (gallery._timer) clearInterval(gallery._timer);
    if (gallery._raf) cancelAnimationFrame(gallery._raf);
    if (gallery._carouselTimers) {
      gallery._carouselTimers.forEach(t => clearInterval(t));
    }
    gallery._timer = null;
    gallery._raf = null;
    gallery._carouselTimers = [];

    const slides = [...gallery.querySelectorAll("[data-slide]")];
    const thumbs = [...gallery.querySelectorAll("[data-dot]")];
    const progress = document.getElementById("gallery-progress-fill");

    let current = 0;

    function currentCard() {
      return slides[current]?.querySelector(".retro-expandable-card");
    }

    function isExpanded() {
      return currentCard()?.dataset.active === "true";
    }

    function updateThumbs() {
      thumbs.forEach((thumb, index) => {
        const card = thumb.closest('.gallery-thumb-card');
        if (card) {
          card.classList.toggle("active", index === current);
        }
      });
    }

    function show(index) {
      if (index < 0) index = slides.length - 1;
      if (index >= slides.length) index = 0;

      document.querySelectorAll(".retro-expandable-card").forEach((card) => {
        card.setAttribute("data-active", "false");
      });

      slides.forEach((slide, i) => {
        slide.style.display = i === index ? "block" : "none";
      });

      current = index;
      updateThumbs();

      const activeSlide = slides[current];
      const bg = activeSlide?.dataset.bg || "";
      const bgImg = document.getElementById("gallery-bg-img");
      if (bgImg) {
        bgImg.src = bg;
        bgImg.style.opacity = bg ? "1" : "0";
      }

      // Scroll the active thumbnail into view
      const activeThumb = thumbs[current];
      if (activeThumb) {
        activeThumb.scrollIntoView({ behavior: 'smooth', block: 'nearest', inline: 'center' });
      }
    }

    function startTimer() {
      stopTimer();
      gallery._timer = setInterval(() => {
        if (!isExpanded()) {
          show(current + 1);
          startProgress();
        }
      }, INTERVAL);
    }

    function stopTimer() {
      if (gallery._timer) {
        clearInterval(gallery._timer);
        gallery._timer = null;
      }
    }

    function startProgress() {
      if (!progress) return;
      if (gallery._raf) cancelAnimationFrame(gallery._raf);
      progress.style.transition = "none";
      progress.style.transform = "scaleX(0)";
      void progress.offsetWidth;
      gallery._raf = requestAnimationFrame(() => {
        progress.style.transition = `transform ${INTERVAL}ms linear`;
        progress.style.transform = "scaleX(1)";
      });
    }

    function pauseProgress() {
      if (!progress) return;
      if (gallery._raf) cancelAnimationFrame(gallery._raf);
      const computed = getComputedStyle(progress);
      const matrix = new DOMMatrix(computed.transform);
      progress.style.transition = "none";
      progress.style.transform = `scaleX(${matrix.m11})`;
    }

    function resetGalleryTimer() {
      stopTimer();
      startProgress();
      startTimer();
    }

    function handleCardClick() {
      requestAnimationFrame(() => {
        if (isExpanded()) {
          stopTimer();
          pauseProgress();
        } else {
          resetGalleryTimer();
        }
      });
    }

    // Initialize carousels for all thumbnails
    function initCarousels() {
      const carousels = gallery.querySelectorAll('.thumb-carousel');
      carousels.forEach((carousel, carouselIndex) => {
        const images = carousel.querySelectorAll('.thumb-carousel-img');
        if (images.length <= 1) return;

        let imageIndex = 0;
        const timer = setInterval(() => {
          images[imageIndex].classList.remove('active');
          imageIndex = (imageIndex + 1) % images.length;
          images[imageIndex].classList.add('active');
        }, CAROUSEL_INTERVAL);

        gallery._carouselTimers.push(timer);
      });
    }

    // Dot click handlers
    thumbs.forEach((thumb) => {
      thumb.addEventListener("click", () => {
        const index = Number(thumb.dataset.dot);
        show(index);
        resetGalleryTimer();
      });
    });

    // Card click handlers
    slides.forEach((slide) => {
      const card = slide.querySelector(".retro-expandable-card");
      if (card) {
        card.addEventListener("click", handleCardClick);
      }
    });

    gallery.addEventListener("card-toggle", () => {
      requestAnimationFrame(() => {
        if (isExpanded()) {
          stopTimer();
          pauseProgress();
        } else {
          resetGalleryTimer();
        }
      });
    });

    // START STATE
    show(0);
    resetGalleryTimer();
    initCarousels();
  }

  function destroyGallery() {
    const gallery = document.getElementById("project-gallery");
    if (!gallery) return;
    gallery.dataset.galleryInitialized = "false";
    if (gallery._timer) {
      clearInterval(gallery._timer);
      gallery._timer = null;
    }
    if (gallery._raf) {
      cancelAnimationFrame(gallery._raf);
      gallery._raf = null;
    }
    if (gallery._carouselTimers) {
      gallery._carouselTimers.forEach(t => clearInterval(t));
      gallery._carouselTimers = [];
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initGallery);
  } else {
    initGallery();
  }

  document.addEventListener("astro:after-swap", () => {
    destroyGallery();
    initGallery();
  });
</script>

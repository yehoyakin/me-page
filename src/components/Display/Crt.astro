---
// Purpose: Component - src/components/Display/Crt.astro (CRT scanline / display effect)
const { id = "crt-display" } = Astro.props;
---

<div
  class="crt-chassis w-full aspect-video bg-zinc-900 border-[0.375rem] border-zinc-800 rounded-xl shadow-[0_1.5625rem_3.75rem_-0.9375rem_rgba(0,0,0,0.9)] relative overflow-hidden flex items-center justify-center"
>
  <div class="crt-filter absolute inset-0 pointer-events-none z-30"></div>

  <div
    id={id}
    class="crt-screen-content w-full h-full relative z-10 p-6 flex flex-col justify-between"
  >
    <slot />
  </div>
</div>

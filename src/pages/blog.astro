---
// Purpose: Page - src/pages/blog.astro (Blog listing)
import MyLayout from "../layouts/MyLayout.astro";
import Title from "../components/UI/Title.astro";
import Body from "../components/UI/Body.astro";
import { getCollection } from "astro:content";
import type { BlogPost } from "../types/blog";
import BlogCard from "../components/sections/BlogCard.astro";
import BackLink from "../components/shared/BackLink.astro";
import { asset } from "../utils/asset";

const posts = (await getCollection("blog")) as BlogPost[];
const bgGif = asset("images/kbg1.gif");

// Sort posts: newest first (left), oldest last (right)
const sortedPosts = posts.sort((a, b) => 
  new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);
---

<MyLayout title="Blog" animation="wipe" preloadImages={[bgGif]}>
  {/* Layered page background for the blog listing. */}
  <div
    class="absolute inset-0 w-full min-h-screen overflow-x-hidden bg-zinc-950"
  >
    {/* Background image layer with soft blur. */}
    <div
      class="fixed inset-0 z-0 pointer-events-none style3d"
      style="filter: blur(0.625rem); transform: scale(1.05);"
    >
      <img
        src={bgGif}
        class="w-full h-full object-cover opacity-100"
        alt=""
        role="presentation"
      />
    </div>

    {/* Overlay to improve contrast over the background image. */}
    <div class="absolute inset-0 z-10 pointer-events-none"></div>

    {/* Main content layer. */}
    <section
      class="relative z-20 py-24 px-4 sm:px-6 md:px-8 w-full"
    >
      <div class="text-center">
        <BackLink />

        <Title class="mt-3 text-5xl md:text-6xl" level={1} theme="primary">
          Blog
        </Title>

        <Body theme="secondary" class="mt-4 max-w-2xl mx-auto" shadow={true}>
          Thoughts on my favorite art.
        </Body>
      </div>

      <div class="mt-16"></div>

      {/* Horizontal scrollable blog cards */}
      <div class="blog-cards-wrapper">
        <div class="blog-cards-scroll">
          {sortedPosts.map((post) => (
            <div class="blog-card-item">
              <BlogCard post={post} />
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>
</MyLayout>

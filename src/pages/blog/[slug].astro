---
// Purpose: Page - src/pages/blog/[slug].astro (Blog post template)
import MyLayout from "../../layouts/MyLayout.astro";
import BackLink from "../../components/shared/BackLink.astro";
import BlogBackgrounds from "../../components/Blog/BlogBackgrounds.astro";
import BlogHeader from "../../components/Blog/BlogHeader.astro";
import BlogContent from "../../components/Blog/BlogContent.astro";
import BlogSidebar from "../../components/Blog/BlogSidebar.astro";
import { getCollection } from "astro:content";
import { asset } from "../../utils/asset";
import { resolveThemeToken, toThemeName, getThemeConfig } from "../../config/uiDictionary";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
  }));
}

const slug = Astro.params.slug;
const posts = await getCollection("blog");
const post = posts.find((entry) => entry.id === slug);

if (!post) {
  throw new Response("Post not found", { status: 404 });
}

const cards = post.data.cards ?? [];

/* ✅ Normalize content scenes through asset */
const scenes = Array.isArray(post.data.scenes)
  ? post.data.scenes.map((s) => ({
      image: asset(s.image),
      align: s.align ?? "center",
    }))
  : [];

/* ✅ Normalize layers through asset */
const rawBackgrounds = post.data.backgrounds ?? [];
const backgrounds = Array.isArray(rawBackgrounds)
  ? rawBackgrounds.map((b) => ({
      image: asset(b.image),
    }))
  : [];

/* ✅ Replace [background[x]] markers in the body with invisible anchors.
   The runtime script reads each anchor's offsetTop to decide when to
   activate background number x. Markers pointing at missing entries
   are stripped. */
const backgroundMarkerRe = /\[background\[(\d+)\]\]/g;
const bodyHtml = (post.rendered?.html ?? "").replace(
  backgroundMarkerRe,
  (_match, indexStr: string) => {
    const index = Number.parseInt(indexStr, 10);
    if (!Number.isInteger(index) || index < 0 || index >= backgrounds.length) {
      return "";
    }
    return `<span class="bg-marker" data-bg-index="${index}"></span>`;
  }
);

/* ✅ Normalize single cover through asset */
const heroImage = post.data.background ? asset(post.data.background) : "";

const backgroundBlur = post.data.backgroundBlur ?? 0;
const backgroundOpacity = post.data.backgroundOpacity ?? 1;
const backgroundParallax = post.data.backgroundParallax ?? 0.2;



// Convention-based theme resolution: theme name → CSS var → font/transition config
const themeName = toThemeName(post.data.theme);
const postDynamicToken = resolveThemeToken(themeName);
const themeConfig = getThemeConfig(themeName);

// Resolve the base URL for internal links.
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;

// Preload the hero and background images for the article page.
const imagesToPreload = [heroImage, ...backgrounds.map((b) => b.image)].filter(
  Boolean,
);
---

<MyLayout
  title={post.data.title}
  animation={themeConfig.transition}
  preloadImages={imagesToPreload}
>
  <div class="relative z-30">
    <BackLink href={`${baseUrl}blog/`} text="← Back to blog" />
  </div>

  <section class="relative py-12 md:py-16 px-4 max-w-4xl mx-auto w-full" style={`--project-tag-color: ${postDynamicToken}`}>
    {/* 1. LAYER RENDERING CONTAINER */}
    <BlogBackgrounds
      backgrounds={backgrounds}
      heroImage={heroImage}
      backgroundBlur={backgroundBlur}
      backgroundOpacity={backgroundOpacity}
    />

    <div class="mt-12 w-full min-w-0">
      {/* 2. BODY GRAPH COLUMN */}
      <div class="flex flex-col gap-6 sm:gap-8 w-full min-w-0">
        <BlogHeader
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          theme={themeName}
        />
        <BlogContent bodyHtml={bodyHtml} scenes={scenes} />
      </div>
    </div>

    {/* End-of-article sentinel for the "That's all" message */}
    <div id="blog-end-sentinel" class="w-full h-1"></div>
  </section>

  {/* That's all for today folks! */}
  <div id="thats-all-msg" class="thats-all-overlay">
    <span class="thats-all-text">That's all for today folks!</span>
  </div>

  {/* Floating sidebar for related articles and cards. */}
  <div
    id="sidebar-container"
    class="group fixed top-1/4 right-0 z-50 flex items-start transition-transform duration-300 translate-x-[calc(100%-2.75rem)] [&.sidebar-open]:translate-x-0"
  >
    {
      /* Swapped to a button for seamless touch tap tracking on mobile screens */
    }
    <button
      id="sidebar-toggle"
      class="bg-black text-white p-3 rounded-l-xl shadow-lg cursor-pointer select-none border border-r-0 border-white/20 group-[.sidebar-open]:opacity-0 transition-opacity duration-200 flex items-center justify-center focus:outline-none"
      aria-label="Toggle Sidebar"
    >
      {/* Chainlink Icon */}
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        stroke-width="2.5"
        stroke="currentColor"
        class="w-5 h-5"
      >
        <path
          stroke-linecap="round"
          stroke-linejoin="round"
          d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"
        ></path>
      </svg>
    </button>

    {/* Hidden Panel Content Container */}
    <div
      class="w-80 max-h-[70vh] overflow-y-auto"
    >
      <BlogSidebar cards={cards} />

  </div>

  {/* 5. MOTION PARALLAX & SIDEBAR CONTROLLER */}
  <script
    define:vars={{
      backgrounds,
      backgroundOpacity,
      backgroundBlur,
      backgroundParallax,
    }}
  >
    const bgOpacity = backgroundOpacity ?? 1;
    const bgBlur = backgroundBlur ?? 0;
    const parallaxFactor = Number(backgroundParallax ?? 0.2);

    // Store the current slug's background descriptors globally so the
    // scroll/resize handler can read them. Explicitly clear any stale data
    // from a previous slug before writing the new array — otherwise a post
    // with zero backgrounds would leave the previous post's array in place
    // and the scroll handler would keep repainting the old images.
    window.__backgrounds = backgrounds?.length
      ? backgrounds.map((b) => ({ image: b.image }))
      : [];

    // Where in the document each [background[x]] marker sits.
    // offsetTop is relative to the offsetParent chain, so convert to
    // absolute document coordinates.
    const getMarkerTops = () => {
      const markers = document.querySelectorAll(".bg-marker");
      if (!markers.length) return [];
      return Array.from(markers)
        .map((el) => {
          let top = 0;
          let node = el;
          while (node) {
            top += node.offsetTop;
            node = node.offsetParent;
          }
          const index = Number.parseInt(el.dataset.bgIndex ?? "0", 10);
          return { top, index };
        })
        .sort((a, b) => a.top - b.top);
    };

    let markerTops = getMarkerTops();

    // Per-layer scroll ranges: layer i drifts from +A to -A across its own
    // segment (first marker that activates it -> next marker for a different
    // background). Sharing one offset computed from the active segment made
    // every layer jump 2*amplitude the instant a marker was crossed, which
    // snapped the crossfade; per-layer ranges keep each layer's motion
    // continuous while it fades in or out. Duplicate markers for the same
    // background are ignored so they can't re-zero the progress either.
    let layerRanges = [];
    const computeLayerRanges = () => {
      const total = (window.__backgrounds || []).length;
      layerRanges = new Array(total).fill(null);
      if (!total) return;
      if (!markerTops.length) {
        // No markers: layer 0 drifts across the whole document.
        layerRanges[0] = { start: 0, end: document.body.scrollHeight };
        return;
      }
      for (let i = 0; i < markerTops.length; i++) {
        const { index, top } = markerTops[i];
        if (layerRanges[index]) continue; // first marker for a layer wins
        let end = document.body.scrollHeight;
        for (let j = i + 1; j < markerTops.length; j++) {
          if (markerTops[j].index !== index) {
            end = markerTops[j].top;
            break;
          }
        }
        layerRanges[index] = { start: index === 0 ? 0 : top, end };
      }
    };

    const updateBackgrounds = () => {
      const bgs = window.__backgrounds || [];
      if (!bgs.length) return;

      // Active = the last [background[x]] marker whose top edge has crossed
      // the viewport center line (scrollY + innerHeight * 0.5).  When a
      // marker's top reaches the center of the screen, the marker is
      // centered (for an inline span) or well into the upper half of the
      // viewport, so the corresponding background should be showing.
      // Before any marker crosses the center line, background 0 stays
      // active so the top of the article always has a visible backdrop.
      const vh = window.innerHeight;
      const centerLine = window.scrollY + vh * 0.5;

      let activeIndex = 0;
      for (let i = 0; i < markerTops.length; i++) {
        const { top, index } = markerTops[i];
        if (top <= centerLine) {
          activeIndex = index;
        } else {
          break;
        }
      }
      activeIndex = Math.min(activeIndex, bgs.length - 1);

      // Continuous parallax: each background drifts from +A to -A across its
      // own segment. The old `-scrollY * factor` formula clamped after a
      // short distance, which froze the background (no parallax). Layers
      // bleed 20vh past the viewport on each side, so cap the drift
      // amplitude inside that to avoid exposing edges.
      const amplitude =
        Math.min(Math.max(parallaxFactor, 0), 0.19) * window.innerHeight;
      const offsetForLayer = (index) => {
        const range = layerRanges[index];
        if (!range) return amplitude;
        const segLength = Math.max(1, range.end - range.start);
        const progress = Math.min(
          1,
          Math.max(0, (focus - range.start) / segLength)
        );
        return amplitude * (1 - 2 * progress);
      };

      bgs.forEach((bg, index) => {
        const bgEl = document.getElementById(`dynamic-bg-${index}`);
        if (!bgEl) return;

        // SSR already set background-image + filter + opacity. Only mutate
        // the properties the scroll handler actually controls (transform +
        // opacity crossfade), so the first client-side update can't flicker
        // if the serialized URL matches the SSR URL. We still write
        // backgroundImage in case the SSR href used a different base than
        // the client-resolved one; setting it to the same value is a no-op
        // in the browser, so there is no visible flash.
        const resolvedSrc =
          bg.image.startsWith("http") || bg.image.startsWith("/")
            ? bg.image
            : `${import.meta.env.BASE_URL.replace(/\/$/, "")}/${bg.image.replace(/^\//, "")}`;

        bgEl.style.backgroundImage = `url('${resolvedSrc}')`;
        bgEl.style.filter = `blur(${bgBlur * 24}px)`;
        bgEl.style.transform = `translate3d(0, ${offsetForLayer(index)}px, 0)`;
        bgEl.style.opacity = index === activeIndex ? String(bgOpacity) : "0";
        bgEl.dataset.active = index === activeIndex ? "1" : "0";
      });
    };

    // Re-measure marker offsets + layer ranges, then repaint.
    const remeasure = () => {
      markerTops = getMarkerTops();
      computeLayerRanges();
      updateBackgrounds();
    };

    // rAF-throttled remeasure: document height changes while scene images
    // and fonts settle, and each change would otherwise force sync layout.
    let measureQueued = false;
    const queueRemeasure = () => {
      if (measureQueued) return;
      measureQueued = true;
      requestAnimationFrame(() => {
        measureQueued = false;
        remeasure();
      });
    };

    // This inline script re-executes after Astro view-transition navigations
    // (when this post's markup is swapped in), so a previous instance's
    // listeners must be torn down or they stack up, each holding stale
    // offsets and the previous post's settings.
    window.__bgController?.destroy();

    const onScroll = () => updateBackgrounds();
    const ro = new ResizeObserver(queueRemeasure);

    window.__bgController = {
      destroy: () => {
        window.removeEventListener("scroll", onScroll);
        window.removeEventListener("resize", queueRemeasure);
        document.removeEventListener("astro:page-load", queueRemeasure);
        ro.disconnect();
      },
    };

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", queueRemeasure);
    document.addEventListener("astro:page-load", queueRemeasure);

    // Watch the document itself: scene images loading (and fonts) grow the
    // page after the swap, which shifts every marker. Crucially, the window
    // "load" event never fires again in an SPA session, so measuring on it
    // alone left offsets stale after client-side navigation and backgrounds
    // activated at the wrong scroll positions.
    ro.observe(document.body);

    if (document.readyState === "complete") {
      // Full load already happened (SPA session): settle one frame, then measure.
      requestAnimationFrame(remeasure);
    } else {
      window.addEventListener("load", remeasure, { once: true });
    }

    // Measure marker positions and repaint. Called immediately, then again
    // after images/fonts settle (load event or ResizeObserver), and on every
    // scroll. The function is safe to call repeatedly — it reads live DOM
    // state each time, so stale offsets cannot persist across calls.
    const remeasureAndPaint = () => {
      markerTops = getMarkerTops();
      computeLayerRanges();
      updateBackgrounds();
    };

    // First measurement: run synchronously so the initial paint has the
    // correct active index. Additional measurements follow after images
    // load (which grow the document and shift markers).
    remeasureAndPaint();

    if (document.readyState === "complete") {
      // SPA navigation: document already fully loaded; images may still
      // be decoding, so also watch for body resize.
      requestAnimationFrame(remeasureAndPaint);
    } else {
      // Full page load: re-measure once everything (images, fonts) has
      // loaded and the document has reached its final height.
      window.addEventListener("load", remeasureAndPaint, { once: true });
    }

    // --- SIDEBAR DYNAMIC DEVICE SCRIPTS ---
    const initSidebar = () => {
      const container = document.getElementById("sidebar-container");
      const toggle = document.getElementById("sidebar-toggle");

      if (!container || !toggle) return;
      if (container.dataset.sidebarBound === "true") return;

      // 1. Mobile & Global Tap Toggle
      toggle.addEventListener("click", (e) => {
        e.stopPropagation();
        container.classList.toggle("sidebar-open");
      });

      // 2. PC Mouse Hover Open
      container.addEventListener("mouseenter", () => {
        container.classList.add("sidebar-open");
      });

      // 3. PC Mouse Hover Close
      container.addEventListener("mouseleave", () => {
        container.classList.remove("sidebar-open");
      });

      // 4. Click Outside Dismissal (Essential to let mobile users hide it)
      document.addEventListener("click", (e) => {
        if (!container.contains(e.target)) {
          container.classList.remove("sidebar-open");
        }
      });

      container.dataset.sidebarBound = "true";
    };

    document.addEventListener("astro:page-load", initSidebar);
    document.addEventListener("DOMContentLoaded", initSidebar);
    initSidebar();

    // --- THAT'S ALL FOLKS MESSAGE ---
    const initThatsAll = () => {
      const sentinel = document.getElementById("blog-end-sentinel");
      const msg = document.getElementById("thats-all-msg");
      if (!sentinel || !msg) return;
      if (sentinel.dataset.bound === "true") return;

      let hasShown = false;

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting && !hasShown) {
              hasShown = true;
              msg.classList.add("visible");
              setTimeout(() => {
                msg.classList.remove("visible");
              }, 2500);
              observer.unobserve(sentinel);
            }
          });
        },
        { threshold: 0.5 }
      );

      observer.observe(sentinel);
      sentinel.dataset.bound = "true";
    };

    document.addEventListener("astro:page-load", initThatsAll);
    document.addEventListener("DOMContentLoaded", initThatsAll);
    initThatsAll();
  </script>
</MyLayout>
